	author = {Kansky, Ken and Silver, Tom and Mély, David A. and Eldawy, Mohamed and Lázaro-Gredilla, Miguel and Lou, Xinghua and Dorfman, Nimrod and Sidor, Szymon and Phoenix, Scott and George, Dileep},
