	keywords = {Humans, Attention, Adult, Female, Magnetic Resonance Imaging, Male, Motor Cortex, Parietal Lobe, Brain Mapping, Behavior, Motion Perception, Nerve Net, Photic Stimulation, Time Perception},
	pages = {97--112},
	file = {PDF:C\:\\Users\\ogeorgeon\\Zotero\\storage\\38V22Y7H\\Schubotz et von Cramon - 2001 - Functional organization of the lateral premotor cortex fMRI reveals different regions activated by.pdf:application/pdf},
}

